// ============================================
// TANABETTING - PRISMA SCHEMA (revised)
// ============================================

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================
// ENUMS
// ============================================




enum Role {
  USER
  ADMIN
  SUB_ADMIN
  ODDS_MANAGER // trading-team access without full admin rights
  AGENT
}

enum GameType {
  SOCCER
  BASKETBALL
  TENNIS
  AMERICAN_FOOTBALL
  BOXING_MMA
  ESPORTS
  OTHER
}

enum GameStatus {
  SCHEDULED
  LIVE
  SUSPENDED   // odds temporarily paused (e.g. VAR review, injury)
  FINISHED
  CANCELLED
  POSTPONED
}


//TODO : check theoddsapi data and updtate the market type
enum MarketType {
  MATCH_WINNER      // 1X2 / moneyline
  OVER_UNDER
  HANDICAP
  BOTH_TEAMS_TO_SCORE
  CORRECT_SCORE
  HALFTIME_FULLTIME // half-time/full-time combos
  PLAYER_PROP
  OUTRIGHT
  CUSTOM
}

enum MarketStatus {
  OPEN
  SUSPENDED
  SETTLED
  CANCELLED
}

enum BetStatus {
  PENDING
  WON
  LOST
  VOID        // e.g. market cancelled, stake returned
  CASHED_OUT
}

enum PayoutStatus {
  PENDING     // not paid out yet
  SUBMITTED   // admin queued/submitted the payout
  PAID        // money transferred to the user
}

enum BetType {
  SINGLE
  MULTIPLE    // parlay/accumulator
  SYSTEM
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  BET_PLACED
  BET_WON
  BET_REFUND
  ADJUSTMENT  // manual admin correction
  REFERRAL_BONUS 
}
enum ReferralStatus {
  PENDING     // signed up with a code, hasn't qualified yet
  QUALIFIED   // hit the deposit threshold
  REWARDED    // referrer has been paid the bonus
}
enum ReferralCodeType {
  PRIMARY     // referrer's main referralCode (usually via ?ref= link)
  SECONDARY   // referrer's manually-assigned second_referralCode (typed into the signup box)
}
// ============================================
// USERS (single table for customers + admins)
// ============================================
enum ThemeMode {
  LIGHT
  DARK
  SYSTEM // follow OS preference
}

enum FundRequestType {
  DEPOSIT
  WITHDRAWAL
}

enum FundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED   // user cancelled before admin review
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  role          Role     @default(USER)
  balance       Decimal  @default(0) @db.Decimal(12, 2)
  heldBalance   Decimal  @default(0) @db.Decimal(12, 2) // locked by pending withdrawals
  isActive      Boolean  @default(true)

  payoutAccountType     String?   // e.g. "BANK", "TELEBIRR", "CBE_BIRR"
  payoutAccountNumber   String?
  payoutAccountUsername String?   // account holder name on the receiving end

  // Kept for later, unused for now
  emailVerified Boolean  @default(false)

   themeMode  ThemeMode @default(SYSTEM)
  themeColor String?   @default("blue") 

  // --- Security hardening ---
  // 2FA: enforced at app layer for ADMIN / ODDS_MANAGER roles.
  // Regular USER accounts can opt in later if you add that feature.
  twoFactorSecret   String?
  twoFactorEnabled  Boolean  @default(false)
  backupCodesHashed Json?    // array of hashed one-time backup codes

  // Brute-force protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Basic login audit trail
  lastLoginAt DateTime?
  lastLoginIp String?

   referralCode String  @unique @default(cuid()) // shown in their referral link
   second_referralCode String? @unique

  referralsMade   Referral[] @relation("ReferralsMade")
  referredAs      Referral?  @relation("ReferralReceived") // this user, as someone else's referee

  devices Device[]

fundRequests         FundRequest[] @relation("UserFundRequests")
fundRequestsReviewed FundRequest[] @relation("FundRequestReviewer")

 stagedGamesStaged   StagedGame[] @relation("StagedGameStagedBy")
  stagedGamesReviewed StagedGame[] @relation("StagedGameReviewedBy")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bets            Bet[]
  transactions    Transaction[]
  notifications   Notification[] @relation("NotificationUser")
  transactionsPerformed Transaction[] @relation("TransactionPerformedBy")
  betsSettled           Bet[]         @relation("BetSettledBy")
  marketsLastActioned   Market[]      @relation("MarketLastAction")
  gamesStatusChanged    Game[]        @relation("GameStatusChangedBy")
  transferAccountsCreated OurTransferAccount[] @relation("TransferAccountCreatedBy")
  appSettingUpdates      AppSetting[] @relation("AppSettingUpdatedBy")
  lastModifiedById String? // admin who last changed this user's role/isActive/balance directly
  lastModifiedBy   User?  @relation("UserLastModifiedBy", fields: [lastModifiedById], references: [id])
  modifiedUsers    User[]  @relation("UserLastModifiedBy")
  refreshTokens   RefreshToken[]
  adminActionLogs AdminActionLog[]

  @@index([email])
  @@index([role])
}

model Referral {
  id String @id @default(cuid())

  referrerId String
  referrer   User   @relation("ReferralsMade", fields: [referrerId], references: [id])

  refereeId String @unique   // one referral record per new user - can't be referred twice
  referee   User   @relation("ReferralReceived", fields: [refereeId], references: [id])

  codeUsed String   // snapshot of the code at signup, in case referrer changes it later
  codeType ReferralCodeType @default(PRIMARY) // which of the referrer's codes was used
  status   ReferralStatus @default(PENDING)

  bonusAmount Decimal @default(50) @db.Decimal(12, 2)

  qualifiedAt DateTime?
  rewardedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId])
  @@index([status])
}


model FundRequest {
  id     String          @id @default(cuid())
  userId String
  user   User            @relation("UserFundRequests", fields: [userId], references: [id])

  type   FundRequestType
  amount Decimal         @db.Decimal(12, 2)
  status FundRequestStatus @default(PENDING)

  // --- Deposit-specific fields ---
  transferAccountId String?              // which of OUR bank accounts they sent to
  transferAccount   OurTransferAccount?  @relation(fields: [transferAccountId], references: [id])
  proofImagePath    String?              // uploaded receipt/screenshot
  senderReference    String?             // e.g. transaction ref number user typed in from their bank

  // --- Withdrawal-specific fields ---
  payoutAccountName   String?
  payoutAccountNumber String?
  payoutBankName      String?

  // --- Admin review ---
  reviewedById    String?
  reviewedBy      User?     @relation("FundRequestReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?

 // --- Withdrawal completion (filled by admin once paid) ---
  completionProofImagePath String?   // admin's screenshot of the completed transfer
  transactionId            String?   // bank/mobile-money tx reference, set once completed
  completedAt              DateTime?

  transaction Transaction?  // set once approved — the resulting ledger entry

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
}

model Transaction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type         TransactionType
  amount       Decimal         @db.Decimal(12, 2)
  balanceAfter Decimal         @db.Decimal(12, 2)
  reference    String?

  fundRequestId String?      @unique
  fundRequest   FundRequest? @relation(fields: [fundRequestId], references: [id])

  performedById String? // admin who manually created this entry (ADJUSTMENT etc.); null for system-generated rows
  performedBy   User?   @relation("TransactionPerformedBy", fields: [performedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([type])
}
enum DeviceType {
  DESKTOP
  MOBILE
  TABLET
  UNKNOWN
}

model Device {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fingerprint to recognize "is this the same device as before"
  deviceFingerprint String  // hash of UA + other stable signals, see below
  deviceType        DeviceType @default(UNKNOWN)
  deviceName        String?    // e.g. "Chrome on Windows" - parsed, user-friendly label
  os                String?    // e.g. "Windows 11", "iOS 17"
  browser           String?    // e.g. "Chrome 128"

  // Network info at most recent (or first) sighting
  ipAddress String
  location  String? // optional: city/country from IP geolocation lookup

  isTrusted  Boolean  @default(false) // user can mark "remember this device"
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  // Optional: link to active session so you can revoke by device
  refreshTokens RefreshToken[]

  @@unique([userId, deviceFingerprint])
  @@index([userId])
  @@index([ipAddress])
}









// ============================================
// AUTH / REFRESH TOKENS
// ============================================

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
 deviceId String?
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  tokenHash String    @unique // sha256 of the opaque refresh token
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
}

// ============================================
// ADMIN ACTION LOG
// Accountability trail for sensitive admin actions:
// manual settlements, balance adjustments, market
// suspensions, etc. Tied to User rather than a
// separate admin table.
// ============================================

model AdminActionLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  action    String // e.g. "MARKET_SUSPENDED", "BALANCE_ADJUSTED", "BET_VOIDED"
  targetType String? // e.g. "Market", "User", "Bet"
  targetId   String? // id of the affected record

  // Free-form context, e.g. { "reason": "duplicate line", "previousBalance": 100 }
  metadata Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([targetType, targetId])
}

// ============================================
// SPORTS / COMPETITIONS / GAMES
// ============================================

model Sport {
  id       String   @id @default(cuid())
  name     String   @unique // e.g. "Soccer"
  slug     String   @unique // e.g. "soccer"
  gameType GameType

  competitions Competition[]

  createdAt DateTime @default(now())
}

model Competition {
  id      String @id @default(cuid())
  name    String // e.g. "Premier League"
  country String?
  sportId String
  sport   Sport  @relation(fields: [sportId], references: [id])
 stagedGames StagedGame[]
  games          Game[]
  outrightMarkets Market[] @relation("CompetitionOutrights")

  createdAt DateTime @default(now())

  @@index([sportId])
}


model Team{
  id String @id @default(cuid())
  oddsApiName        String? @unique // exact name string from The Odds API
  footballDataName   String? @unique // exact name string from football-data.org
  footballDataTeamId Int?    @unique // stable numeric team id football-data.org provides
    fullName   String  // canonical display name, e.g. "Manchester United"
  shortName  String?
  iconUrl    String? // crest/logo image URL
  country    String?
  isNational Boolean @default(false)
  homeGames Game[] @relation("HomeTeam")
  awayGames Game[] @relation("AwayTeam")

    stagedGamesAsHome StagedGame[] @relation("StagedGameHomeTeam")
  stagedGamesAsAway StagedGame[] @relation("StagedGameAwayTeam")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
@@index([country])
}

enum StagedGameStatus {
  PENDING            // staged, awaiting admin confirmation
  MATCH_NOT_FOUND    // no matching football-data fixture found yet for this odds-api event
  CONFIRMED          // admin approved — added to Game
  REJECTED           // admin determined this isn't a valid/wanted match
}

enum FootballDataMatchStatus {
  SCHEDULED
  TIMED
  IN_PLAY
  PAUSED
  FINISHED
  POSTPONED
  SUSPENDED
  CANCELLED
  AWARDED
}


model StagedGame {
  id String @id @default(cuid())

  // --- The Odds API side ---
  oddsApiEventId   String    @unique
  oddsApiStartTime DateTime
  oddsApiRaw       Json      // full event payload as fetched, for admin review

  // --- football-data.org side (nullable until a match is found) ---
  footballDataMatchId  Int?      @unique
  footballDataStartTime DateTime?
  footballDataRaw      Json?     // full match payload as fetched, once matched
  footballDataStatus   FootballDataMatchStatus?

  // --- resolved teams (via your Team table, not raw strings) ---
  homeTeamId String
  homeTeam   Team   @relation("StagedGameHomeTeam", fields: [homeTeamId], references: [id])
  awayTeamId String
  awayTeam   Team   @relation("StagedGameAwayTeam", fields: [awayTeamId], references: [id])

  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])

  status StagedGameStatus @default(PENDING)

  stagedById    String?    // admin who selected it from the odds-api list
  stagedBy      User?      @relation("StagedGameStagedBy", fields: [stagedById], references: [id])
  reviewedById  String?    // admin who confirmed/rejected it
  reviewedBy    User?      @relation("StagedGameReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt    DateTime?
  rejectionReason String?

  gameId String? @unique // set once confirmed — the resulting Game record
  game   Game?   @relation(fields: [gameId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([homeTeamId, awayTeamId])
}


model Game {
  id            String      @id @default(cuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id])
  externalEventId String?     @unique
  homeTeam  String
  awayTeam  String
  stagedGame StagedGame? 
  startTime DateTime
  status    GameStatus @default(SCHEDULED)
  statusChangedById String? // admin who last changed Game.status manually (null when changed by football-data sync)
  statusChangedBy   User?   @relation("GameStatusChangedBy", fields: [statusChangedById], references: [id], onDelete: SetNull)
 score  GameScore?
  // Flexible bucket for sport-specific info without new tables per sport
  // e.g. { "period": "2H", "clock": "63:00", "score": { "home": 1, "away": 0 } }


   homeTeamId  String?
  awayTeamId  String?
  homeTeamRef Team?   @relation("HomeTeam", fields: [homeTeamId], references: [id])
  awayTeamRef Team?   @relation("AwayTeam", fields: [awayTeamId], references: [id])

  specifications Json?
 isPublished Boolean @default(false)
  markets Market[]
checkpoints OddsFetchCheckpoint[]

 lastOddsFetchAt DateTime?
  nextOddsFetchAt DateTime?  @default(now())

  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([competitionId])
  @@index([startTime])
  @@index([status])
   @@index([externalEventId])
  @@index([isPublished])
}

enum ScoreDuration {
  REGULAR
  EXTRA_TIME
  PENALTIES
}


model GameScore {
  id                  String   @id @default(cuid())
  gameId              String   @unique
  game                Game     @relation(fields: [gameId], references: [id])

  footballDataMatchId Int      @unique

  winner   String?       // "HOME_TEAM" | "AWAY_TEAM" | "DRAW"
  duration ScoreDuration @default(REGULAR)

  homeScoreHT         Int
  awayScoreHT         Int

  // 90-minute score — settle standard markets (1X2, totals, BTTS) on THIS,
  // not fullTime, once duration != REGULAR
  homeScoreRegularTime Int?
  awayScoreRegularTime Int?

  homeScoreFT         Int   // final score as reported (includes ET/pens if applicable)
  awayScoreFT         Int

  homeScoreExtraTime  Int?  // set only if duration is EXTRA_TIME or PENALTIES
  awayScoreExtraTime  Int?

  homeScorePenalties  Int?  // set only if duration is PENALTIES
  awayScorePenalties  Int?

  status  String // raw status at fetch time, e.g. "FINISHED"
  rawJson Json?  // full API response snapshot, for audit/debugging

  fetchedAt DateTime @default(now())

  @@index([footballDataMatchId])
}

model OddsFetchCheckpoint {
  id         String   @id @default(cuid())
  gameId     String
  game       Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  checkpoint String   // "24h", "6h", "1h", "15m"
  fetchedAt  DateTime @default(now())

  @@unique([gameId, checkpoint])
  @@index([gameId])
}
// ============================================
// MARKETS / SELECTIONS / ODDS
// ============================================

// A Market belongs to EITHER a Game OR a Competition (for outrights),
// never both. Enforce the "exactly one" rule at the application layer
// (Prisma can't express XOR constraints directly).
model Market {
  id     String  @id @default(cuid())
  gameId String?
  game   Game?   @relation(fields: [gameId], references: [id])

  competitionId String?
  competition   Competition? @relation("CompetitionOutrights", fields: [competitionId], references: [id])

  type   MarketType
  name   String // e.g. "Match Winner", "Over/Under 2.5", "Tournament Winner"
  status MarketStatus @default(OPEN)

  // For parameterized markets like Over/Under or Handicap
  // e.g. { "line": 2.5 } or { "handicap": -1.5 }
  parameters Json?

sourceBookmakerKeys Json?     // e.g. ["bet365", "skybet"] — MySQL/Prisma has no native string array
  lastSourceCheckedAt DateTime? // when the cron last checked these bookmakers for new data
  lastActionById String? // admin who last suspended/cancelled/reopened/edited this market (null when changed by odds-feed automation)
  lastActionBy   User?   @relation("MarketLastAction", fields: [lastActionById], references: [id], onDelete: SetNull)
  lastActionAt   DateTime?
  
  selections Selection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId])
  @@index([competitionId])
  @@index([status])
}

model Selection {
  id       String @id @default(cuid())
  marketId String
  market   Market @relation(fields: [marketId], references: [id])

  name      String // e.g. "Home", "Draw", "Away", "Over"
  odds      Decimal  @db.Decimal(8, 3) // decimal odds, e.g. 1.950
  isWinning Boolean? // null until settled

  oddsHistory   OddsHistory[]
  betSelections BetSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([marketId])
}

// Tracks every odds change so you can show movement / build an odds API feed
model OddsHistory {
  id          String    @id @default(cuid())
  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id], onDelete: Cascade)

  odds       Decimal  @db.Decimal(8, 3)
  recordedAt DateTime @default(now())

  @@index([selectionId, recordedAt])
}

// ============================================
// EXTERNAL ODDS FEED (The Odds API staging)
// Raw per-bookmaker snapshot, kept separate from
// Selection.odds so your own pricing/margin logic
// stays independent of any single external source.
// Not linked by foreign key to Game/Market/Selection
// on purpose — the external event/market/outcome keys
// don't line up 1:1 with your ids, so your ingestion
// job resolves that mapping in code, not in the schema.
// ============================================

model BookmakerOdds {
  id String @id @default(cuid())

  externalEventId String // The Odds API "id" field for the event
  sportKey        String // e.g. "soccer_epl"
  bookmakerKey    String // e.g. "pinnacle"
  marketKey       String // e.g. "h2h", "totals", "spreads"
  outcomeName     String // e.g. "Arsenal", "Over"
  point           Decimal? @db.Decimal(8, 3) // line, if applicable (totals/spreads)
  price           Decimal  @db.Decimal(8, 3) // bookmaker's decimal odds

  fetchedAt DateTime @default(now())

  @@index([externalEventId])
  @@index([sportKey, bookmakerKey, marketKey])
  @@index([fetchedAt])
}

// ============================================
// BETS
// ============================================

model Bet {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  type            BetType   @default(SINGLE)
  stake           Decimal   @db.Decimal(12, 2)
  totalOdds       Decimal   @db.Decimal(10, 3) // combined odds at placement
  potentialPayout Decimal   @db.Decimal(12, 2)
  status          BetStatus @default(PENDING)
  payoutStatus    PayoutStatus @default(PENDING)
  settledPayout   Decimal    @default(0) @db.Decimal(12, 2)
  paidOutAt       DateTime?
  settledById String? // admin who manually forced this bet's settlement (null for automatic settlement)
  settledBy   User?   @relation("BetSettledBy", fields: [settledById], references: [id], onDelete: SetNull)

  selections BetSelection[]

  placedAt  DateTime  @default(now())
  settledAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([payoutStatus])
}

// Join table: a bet can contain multiple selections (parlay),
// and stores the odds AT TIME OF BET (odds move, this must not)
model BetSelection {
  id    String @id @default(cuid())
  betId String
  bet   Bet    @relation(fields: [betId], references: [id], onDelete: Cascade)

  selectionId String
  selection   Selection @relation(fields: [selectionId], references: [id])

  oddsAtPlacement Decimal   @db.Decimal(8, 3)
  result          BetStatus @default(PENDING) // per-leg result for parlays

  @@index([betId])
  @@index([selectionId])
}

// ============================================
// WALLET / TRANSACTIONS
// ============================================




model OurTransferAccount {
    id          String    @id @default(cuid())
    accountType String?
    accountName String?
    accountNumber String
    bankName    String?
    bankCode    String?
    branchName  String?
    branchCode  String?
    swiftCode   String?
  fundRequests FundRequest[]
  createdById String? // admin who created this transfer account
  createdBy   User?   @relation("TransferAccountCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
    
    status Boolean @default(true)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @updatedAt
}

// ============================================
// APP SETTINGS (admin-editable operational values)
// ============================================

model AppSetting {
  key         String   @id // e.g. "referral.bonus_amount"
  valueNumber Decimal? @db.Decimal(12, 2)
  valueString String?
  valueBool   Boolean?
  updatedById String? // admin who last changed it
  updatedBy   User?   @relation("AppSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
}

// ============================================
// NOTIFICATIONS
// ============================================

enum NotificationAudience {
  USER   // visible to one specific user (userId = recipient)
  ADMIN  // visible on the admin notifications menu (userId = subject user, if any)
}

model Notification {
  id       String               @id @default(cuid())
  audience NotificationAudience
  userId   String? // recipient for USER; subject user for ADMIN (null for game events)
  user     User?   @relation("NotificationUser", fields: [userId], references: [id], onDelete: SetNull)

  type    String // GAME_FINISHED | USER_REGISTERED | DEPOSIT_REQUESTED | WITHDRAWAL_REQUESTED | DEPOSIT_APPROVED | WITHDRAWAL_APPROVED | REFERRAL_SIGNUP
  title   String
  message String?
  linkUrl String? // in-app destination, e.g. /admin/bet-games/<id>

  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([audience, isRead, createdAt])
  @@index([userId])
}


