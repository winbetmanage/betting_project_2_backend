{
  "name": "betting-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend service for betting platform",
  "main": "server.ts",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc && prisma generate && prisma validate",
    "dev": "tsx watch server.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "prisma:generate": "prisma generate",
    "diag": "node -e \"console.log('node:', process.version, process.execPath); const fs=require('fs'); fs.existsSync('node_modules/.bin/prisma') ? console.log('.bin/prisma: EXISTS') : console.log('.bin/prisma: MISSING'); try { console.log(require('child_process').execFileSync('node', ['node_modules/prisma/build/index.js','--version'], {encoding:'utf8'})) } catch(e) { console.log('local cli error:', e.message) }\"",
    "setup:server": "npm install --include=dev --no-audit --no-fund && prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:validate": "prisma validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "prisma": "^6.19.3",
    "sharp": "^0.35.4",
    "validator": "^13.12.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/validator": "^13.15.10",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
