NODE_ENV=development
PORT=3000
HOST=localhost

# Auth
JWT_SECRET=change_me_to_a_strong_random_string_at_least_32_chars
REFRESH_TOKEN_SECRET=change_me_to_another_strong_random_string
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# CORS - comma separated (frontend URL)
CORS_ORIGIN=http://localhost:4000

# Database - set your own MySQL/Postgres URL
DATABASE_URL="mysql://user:password@localhost:3306/betting_db"

# Optional external API key (do not commit real value)
API_ONE=""
